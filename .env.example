# Sovereign AI Workbench Environment Variables

# Security
SAW_SECRET_KEY=sovereign-workbench-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use local SQLite in storage/workbench.db (default), or point to PostgreSQL:
DATABASE_URL=sqlite+aiosqlite:///storage/workbench.db
# DATABASE_URL=postgresql+asyncpg://saw_user:saw_password@localhost:5432/saw_db

# Local Model Runtimes
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
DEFAULT_MODEL_ID=sovereign-deepseek-r1-q4

# Storage & Sandboxing
MAX_FILE_SIZE_MB=50
ALLOW_CODE_EXECUTION=true
AIR_GAPPED_MODE=true
