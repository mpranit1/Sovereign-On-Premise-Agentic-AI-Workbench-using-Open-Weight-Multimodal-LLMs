# Dependencies
node_modules/
frontend/node_modules/
frontend/dist/

# Python cache & virtual environment
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/

# Environment files
.env
!.env.example

# Local storage and database files
storage/*.db
storage/*.db-journal
storage/uploads/*
!storage/uploads/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/ollama_models/*
!storage/ollama_models/.gitkeep

# Allow sample documents
!storage/documents/*.txt
!storage/documents/*.csv
!storage/documents/.gitkeep

# IDE and OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
